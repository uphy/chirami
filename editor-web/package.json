{
  "name": "chirami-editor-web",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "build": "npm run typecheck && esbuild src/main.ts --bundle --minify --sourcemap --loader:.tsx=tsx --jsx=automatic --outfile=../Chirami/Resources/editor/bundle.js && esbuild src/style.css --bundle --minify --loader:.woff=file --loader:.woff2=file --outfile=../Chirami/Resources/editor/bundle.css && node scripts/copy-html.js",
    "dev": "esbuild src/main.ts --bundle --watch --loader:.tsx=tsx --jsx=automatic --outfile=../Chirami/Resources/editor/bundle.js"
  },
  "dependencies": {
    "@codemirror/commands": "^6",
    "@codemirror/lang-markdown": "^6",
    "@codemirror/language": "^6",
    "@codemirror/language-data": "^6",
    "@codemirror/search": "^6",
    "@codemirror/state": "^6",
    "@codemirror/view": "^6",
    "@excalidraw/excalidraw": "^0.18.1",
    "@lezer/highlight": "^1",
    "@lezer/markdown": "^1",
    "mermaid": "^11.16.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "turndown": "^7",
    "turndown-plugin-gfm": "^1",
    "yaml": "^2.9.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@types/turndown": "^5",
    "esbuild": "^0.28",
    "eslint": "^10.8.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.7.0",
    "typescript": "^5",
    "typescript-eslint": "^8.65.0",
    "vitest": "^4.1.10"
  }
}
