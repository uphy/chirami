.DS_Store
*.xcuserstate
xcuserdata/
.build/
/build/
DerivedData/
# Package.resolved is intentionally tracked: Chirami is an app, not a library,
# so the SPM lockfile must be committed for reproducible builds and for the
# CI cache key (hashFiles) to actually vary.
.swiftpm/
*.xccheckout
*.moved-aside
*.pbxuser
.kiro/settings/
.mise/cache/
CLAUDE.local.md
.claude/settings.local.json
node_modules/
docs/.vitepress/dist/
docs/.vitepress/cache/
# Screenshots from `/chirami-verify` runs: local review artifacts that can
# capture whatever else is on screen, so they must never be committed.
docs/ui-review/
Chirami/Resources/editor/bundle.js
Chirami/Resources/editor/bundle.js.map
Chirami/Resources/editor/bundle.css
Chirami/Resources/editor/index.html
Chirami/Resources/editor/*.woff2
__pycache__/
